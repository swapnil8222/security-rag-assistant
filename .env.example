SERVER_PORT=5000

LLM_DRIVER=ollama
LLM_HOST=localhost
LLM_PORT=11434
LLM_MODEL=qwen3:1.7b
LLM_MODEL_REFINE_QUERY=qwen3:1.7b
# Security answers need room for several C chunks + summaries in one prompt.
# Ollama's default context window is small; 8192+ is recommended for auditing.
LLM_NUM_CTX=8192
# Low temperature = precise, reproducible audit answers
LLM_TEMPERATURE=0.1
# Max tokens the model may write per summary/answer (stops runaway repetition loops).
# 512 suits summaries; raise to ~1500 for long answers with `npm run ask`.
LLM_NUM_PREDICT=512
# >1 discourages the model from repeating itself
LLM_REPEAT_PENALTY=1.15

LLM_EMBEDDING_DRIVER=ollama
LLM_EMBEDDING_MODEL=snowflake-arctic-embed2:568m
LLM_EMBEDDING_OLLAMA_HOST=localhost
LLM_EMBEDDING_OLLAMA_PORT=11434
# Max characters embedded per record; longer text is truncated for the embedding only
EMBED_MAX_CHARS=4000

VECTOR_DB_DRIVER=chroma
# One collection can hold several code bases (one folder each under source-code/);
# pick one per question with the `codebase` option.
VECTOR_DB_COLLECTION_NAME=nginx-audit
VECTOR_DB_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_NAME=docker
DB_USER=root
DB_PASS=root
# docker-compose maps MariaDB to host port 3307
DB_PORT=3307
DB_DIALECT=mysql

# Ingestion (C/C++ auditing)
# Comma-separated extensions scanned under ./source-code
SCAN_EXTENSIONS=c,h
# Max characters per C/C++ chunk; whole functions/structs are kept together up to this size
CHUNK_SIZE_C=3000
# Overlap used only when a single function is larger than CHUNK_SIZE_C
CHUNK_OVERLAP_C=200
